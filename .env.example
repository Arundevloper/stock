# Copy to .env and fill in. Every value here has a working default except the Kite keys.

# --- Zerodha Kite Connect (developers.kite.trade -> create app, Connect plan) ---
KITE_API_KEY=
KITE_API_SECRET=
# In the Kite app settings set Redirect URL to: <PUBLIC_URL>/auth/callback

# --- URLs / security ---
PUBLIC_URL=http://127.0.0.1:8000        # how you reach the web UI (used in Telegram login links)
BACKEND_URL=http://127.0.0.1:8000       # where the reader POSTs candles
INGEST_KEY=change-me                    # shared secret reader -> backend. CHANGE THIS.
APP_USERNAME=                           # set both to protect the UI with HTTP basic auth (do this on a VPS)
APP_PASSWORD=

# --- storage ---
# DATABASE_URL=sqlite:///data/trading.db
# DATABASE_URL=postgresql+psycopg://trader:secret@localhost:5432/trading

# --- trading / risk ---
SIGNAL_MODE=model          # model = ML filter | rule = every setup (paper-test the base rule, no model needed)
# SIGNAL_THRESHOLD=0.70    # override the threshold chosen by training
CAPITAL=100000
RISK_PER_TRADE=0.01        # 1% of capital at risk per trade
MIS_LEVERAGE=5
WATCHLIST_MODE=scan        # scan = 09:31 relative-volume/gap scan | universe = whole universe
WATCHLIST_SIZE=25
MIN_TURNOVER_CR=2          # first-15-min turnover filter (crore rupees)

# --- Telegram (@BotFather -> token; message the bot, then get chat_id from getUpdates) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TRADE_UPDATES=true

# --- ops ---
SCHEDULER_ENABLED=true
RETRAIN_ENABLED=true
RETRAIN_TIME=20:00
BACKFILL_AFTER_CLOSE=true
STALE_DATA_MINUTES=3
HEALTHCHECK_URL=           # e.g. https://hc-ping.com/<uuid>, pinged every minute while data flows
SENTRY_DSN=
LOG_LEVEL=INFO
